<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" styleClass="app-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.airh.agent.ui.MainShellController">
    <BorderPane fx:id="shellRoot" styleClass="app-root">
        <left>
            <VBox prefWidth="232" spacing="20" styleClass="sidebar">
                <VBox spacing="10" styleClass="brand-block">
                    <Label styleClass="sidebar-title" text="AI Remote Helper" wrapText="true" />
                    <Label styleClass="mode-badge" text="LAN Mode" />
                    <Label styleClass="sidebar-subtitle" text="可见、可控的远程协助" wrapText="true" />
                </VBox>

                <VBox spacing="9" styleClass="nav-list" VBox.vgrow="ALWAYS">
                    <Button fx:id="homeNavButton" maxWidth="Infinity" onAction="#showHome" styleClass="nav-button" text="首页" />
                    <Button fx:id="assistedNavButton" maxWidth="Infinity" onAction="#showAssisted" styleClass="nav-button" text="我需要帮忙" />
                    <Button fx:id="controllerNavButton" maxWidth="Infinity" onAction="#showController" styleClass="nav-button" text="我要帮别人" />
                    <Button fx:id="settingsNavButton" maxWidth="Infinity" onAction="#showSettings" styleClass="nav-button" text="设置" />
                    <Button fx:id="aboutNavButton" maxWidth="Infinity" onAction="#showAbout" styleClass="nav-button" text="关于" />
                </VBox>

                <Region VBox.vgrow="ALWAYS" />
                <VBox spacing="8" styleClass="sidebar-footer">
                    <Label styleClass="sidebar-footer-title" text="当前工作模式" wrapText="true" />
                    <Label styleClass="muted-text" text="局域网直连，不隐藏运行。" wrapText="true" />
                    <Label styleClass="version-text" text="版本 0.1.2" />
                </VBox>
                <padding>
                    <Insets bottom="20" left="18" right="18" top="22" />
                </padding>
            </VBox>
        </left>
        <center>
            <StackPane fx:id="contentPane" styleClass="content-pane" />
        </center>
    </BorderPane>
</StackPane>
